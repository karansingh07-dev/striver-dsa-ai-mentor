# ============================================================
# Striver DSA AI Mentor — Server Environment Configuration
# Copy this file to server/.env and fill in your ACTUAL values.
# NEVER commit .env to version control — it is in .gitignore.
# ============================================================

# Server
PORT=5000

# Python RAG API
PYTHON_RAG_URL=http://127.0.0.1:8000

# CORS: comma-separated allowed origins for the Node backend.
# In production set this to your real frontend origin, e.g. https://dsa.example.com
FRONTEND_URL=http://localhost:5173

# Request timeout in milliseconds for Node -> Python calls.
PYTHON_REQUEST_TIMEOUT=120000
