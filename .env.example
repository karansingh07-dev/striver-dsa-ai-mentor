# ============================================================
# Striver DSA AI Mentor — Environment Configuration
# Copy this file to .env and fill in your ACTUAL values.
# NEVER commit .env to version control — it is in .gitignore.
# ============================================================

# ----------------------------
# Qdrant Vector Database
# ----------------------------
# Cloud (Qdrant Cloud): set both QDRANT_URL and QDRANT_API_KEY
# Local disk fallback : leave QDRANT_URL empty
QDRANT_URL=https://your-cluster-url.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=striver_dsa_chunks
YTRAG_QDRANT_BATCH_SIZE=64
# Connection/request timeout in seconds for Qdrant operations.
# Increase this if you see "write operation timed out" on Qdrant Cloud free tier.
QDRANT_TIMEOUT=300

# ----------------------------
# YouTube / yt-dlp Authentication (Phase 7.1)
# ----------------------------
# Fixes "Sign in to confirm you're not a bot". Reads cookies from a browser
# yt-dlp supports (chrome, edge, firefox, brave, opera, ...). Close the browser
# first so its cookie database is unlocked, then re-run:
#   python main.py --retry-failed
# Leave empty (or unset) to download anonymously.
YTDLP_COOKIES_FROM_BROWSER=
# Optional: path to an exported Netscape-format cookies.txt. When set, it wins
# over YTDLP_COOKIES_FROM_BROWSER. e.g. YTDLP_COOKIES_FILE=C:\path\to\cookies.txt
YTDLP_COOKIES_FILE=

# ----------------------------
# Retrieval Settings (Phase 6: two-stage retrieval + quality)
# ----------------------------
# Stage-1 candidate pool size pulled from Qdrant (recall).
YTRAG_RETRIEVAL_K=15

# Stage-3 number of final context chunks fed to the LLM.
YTRAG_TOP_K=5

# Minimum cosine similarity score (0.0 - 1.0).
# Queries whose top result scores below this are rejected before the LLM is called.
# 0.25 cleanly separates DSA queries (~0.45+) from unrelated ones (~0.21).
# Leave empty to use the built-in default 0.25.
YTRAG_MIN_SCORE=0.25

# Overlap deduplication: two chunks from the SAME video whose time ranges overlap
# by >= this ratio are considered duplicates (highest score wins). Adjacent chunks
# from timestamp-aware chunking only overlap ~0.2 of their duration, so they survive.
YTRAG_DEDUP_OVERLAP_RATIO=0.7

# ----------------------------
# LLM Provider  (groq | gemini | openai)
# ----------------------------
LLM_PROVIDER=groq

# Groq  → https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini  → https://ai.google.dev
GEMINI_API_KEY=

# OpenAI  → https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override the default model for the chosen provider.
# Groq default   : openai/gpt-oss-20b  (llama-3.3-70b-versatile was retired by Groq)
# Gemini default : gemini-2.5-flash
# OpenAI default : gpt-4o-mini
LLM_MODEL=openai/gpt-oss-20b

